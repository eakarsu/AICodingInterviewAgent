NODE_ENV=development
PORT=3020
FRONTEND_PORT=3021
FRONTEND_URL=http://localhost:3021
CORS_ORIGINS=http://localhost:3021
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/ai_coding_interview_db
JWT_SECRET=replace-with-at-least-32-random-characters
SANDBOX_CALLBACK_SECRET=replace-with-an-independent-32-character-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DEMO_ADMIN_PASSWORD=
